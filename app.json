{
  "expo": {
    "name": "PocketOllm",
    "slug": "pocketollm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img/icon.png",
    "scheme": "pocketollm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.pocketollm.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/img/foreground.png",
        "backgroundImage": "./assets/img/background.png",
        "monochromeImage": "./assets/img/icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "server",
      "favicon": "./assets/img/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/img/icon.png",
          "imageWidth": 76
        }
      ],
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
